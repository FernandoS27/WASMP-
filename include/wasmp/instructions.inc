// wasmp — instructions.inc
// THE opcode table: the single source of truth the emitter API, the debug
// validator, and the test disassembler are all generated from. This file is
// included multiple times, each time with WASMP_OP defined differently by the
// consumer (see DESIGN.md §4). It has no include guard by design.
//
// Row contract:
//   WASMP_OP(Name, Opcode, Immediate, StackEffect, Feature)
//
//   Name        PascalCase method / enum name, 1:1 with the spec mnemonic
//               (i32.add -> I32Add). Greppable against the spec.
//   Opcode      a single byte (0x6A) for the main space, or WASMP_PFX(p, s)
//               for the 0xFC misc / 0xFD SIMD / 0xFE atomics spaces.
//   Immediate   one of the immediate SHAPES below — decides the method's
//               parameter list and how many bytes to reserve:
//                 NONE            no immediate
//                 LOCAL_IDX       LocalIdx           GLOBAL_IDX  GlobalIdx
//                 TABLE_IDX       TableIdx           FUNC_IDX    FuncIdx
//                 TYPE_IDX        TypeIdx            MEM_IDX     MemIdx
//                 DATA_IDX        DataIdx            ELEM_IDX    ElemIdx
//                 MEMARG(N)       MemArg (natural alignment log2 = N)
//                 MEMINIT         DataIdx + reserved memory-index byte
//                 I32/I64         literal const (SLEB)
//                 F32/F64         literal const (raw LE)
//                 REF_TYPE        RefType
//                 LANE            SIMD lane index (u8)
//                 BLOCK_TYPE      block/loop/if — hand-written (frame handle)
//                 BR_LABEL        br/br_if — hand-written (frame target)
//                 BR_TABLE        br_table — hand-written
//                 CALL_INDIRECT   call_indirect — hand-written (two immediates)
//                 CTRL_DELIM      end/else — emitted by the frame handle
//   StackEffect  (pops) -> (pushes), or SPECIAL for value-polymorphic / call /
//                control ops the validator (M3) hand-codes. Ignored by the
//                emitter; consumed by the validator and the test disassembler.
//   Feature     the Features flag gating emission (MVP is always on).

// ===========================================================================
// Control
// ===========================================================================
WASMP_OP(Unreachable, 0x00, NONE,        SPECIAL,               MVP)
WASMP_OP(Nop,         0x01, NONE,        () -> (),              MVP)
WASMP_OP(Block,       0x02, BLOCK_TYPE,  SPECIAL,               MVP)
WASMP_OP(Loop,        0x03, BLOCK_TYPE,  SPECIAL,               MVP)
WASMP_OP(If,          0x04, BLOCK_TYPE,  SPECIAL,               MVP)
WASMP_OP(Else,        0x05, CTRL_DELIM,  SPECIAL,               MVP)
WASMP_OP(End,         0x0B, CTRL_DELIM,  SPECIAL,               MVP)
WASMP_OP(Br,          0x0C, BR_LABEL,    SPECIAL,               MVP)
WASMP_OP(BrIf,        0x0D, BR_LABEL,    SPECIAL,               MVP)
WASMP_OP(BrTable,     0x0E, BR_TABLE,    SPECIAL,               MVP)
WASMP_OP(Return,      0x0F, NONE,        SPECIAL,               MVP)
WASMP_OP(Call,        0x10, FUNC_IDX,    SPECIAL,               MVP)
WASMP_OP(CallIndirect,0x11, CALL_INDIRECT, SPECIAL,             MVP)

